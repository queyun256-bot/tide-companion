state.*.json
state-*.json
userdata/
backups/
exports/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Proprietary Live2D Core is obtained separately from Live2D, not redistributed in Git.
/assets/vendor/live2dcubismcore.min.js
